# Settings for release/ios/build_testflight.sh. Copy to `testflight.env` beside the checkout (outside
# the repository: it holds the team) and fill in. Every key is optional; the defaults are shown.
# The file is read by bash: KEY=value, quote values with spaces.

# The tester app's identity (decision 47). Not the development app's `.dev` identifier.
BUNDLE_ID=app.satsuma3d
PRODUCT_NAME="Satsuma 3D"
MARKETING_VERSION=0.1.0
# CFBundleVersion: raise it for every upload.
BUILD_NUMBER=1
# Where the exact source of this build is published (About shows it with the commit).
SOURCE_URL=https://github.com/NeroSiegfried/satsuma3d

# Signing. Leave empty for an unsigned, prepared and checked build. With all of them, and a clean
# checkout, the script also archives and exports an .ipa to disk. It never uploads.
# TEAM_ID: the paid team's ten-character id (Xcode > Settings > Accounts).
TEAM_ID=
# SIGNING_IDENTITY: a certificate of that team, by name or SHA-1 (`security find-identity -v -p codesigning`).
SIGNING_IDENTITY=
# PROFILE: a provisioning profile for <TEAM_ID>.<BUNDLE_ID> granting `entitlements.plist`. Empty:
# the newest installed one that matches is used.
PROFILE=

# ROUND5 8M: OFF (the default) links Python without `_ssl` and `_hashlib`, so the app carries no
# general encryption library (OpenSSL). ON links them and OpenSSL, as build 1 did.
# PYTHON_OPENSSL=OFF

# ROUND5 8M.2 (decision 98): what the tester build claims about encryption. The app still holds
# format ciphers inside FFmpeg and libharu (the build lists them); whether that is "using encryption"
# in Apple's sense is the owner's decision, not the build's.
#   ask     (the default) no ITSAppUsesNonExemptEncryption key: App Store Connect asks at upload.
#   exempt  the owner's recorded decision: the key is written false, but only when the check finds no
#           general encryption library and nothing unreviewed; otherwise there is still no key.
ENCRYPTION_CLAIM=ask

# Where to build. Never the development build directory.
# BUILD_DIR=/path/to/build_ios_testflight
# LIBDIR=/path/to/checkout/lib/ios_arm64
# MINIMUM_OS=27.0
