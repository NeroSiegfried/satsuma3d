<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Production scenes need more than the default per-process memory allowance. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
	<!-- Renders go on in the background with the GPU, as a continued processing task. -->
	<key>com.apple.developer.background-tasks.continued-processing.gpu</key>
	<true/>
</dict>
</plist>
