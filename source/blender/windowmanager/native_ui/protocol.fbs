// The protocol between Blender and a platform's own interface, such as the iPad's SwiftUI one or
// an Android one: see `WM_native_ui.h` for how it is exchanged, and `README.md` beside this file.
//
// Blender describes what an interface shows as views, each a tree of nodes with stable keys. An
// interface subscribes to the views it shows; Blender sends each one whole once, then only the
// nodes that changed. The interface sends commands back, aimed at a node of a view.
//
// Most views are made of controls (panels, fields, buttons, lists, menus), which an interface
// draws with its own native controls, the same way for every view. Views with a canvas of their
// own, such as the node editor, send its contents as data.
//
// `flatc` generates each language's code from this file, see `generate.py`.

namespace Blender.NativeUI;

/* -------------------------------------------------------------------- */
/* Values */

table BoolValue {
  value: bool;
}

table IntValue {
  value: long;
}

table FloatValue {
  value: double;
}

table TextValue {
  value: string;
}

table FloatsValue {
  value: [double];
}

table IntsValue {
  value: [long];
}

table TextsValue {
  value: [string];
}

/// A value of a field, of a command, or of a view's parameter.
union Value {
  BoolValue,
  IntValue,
  FloatValue,
  TextValue,
  FloatsValue,
  IntsValue,
  TextsValue,
}

/// A named value, such as a view's parameter.
table Param {
  key: string (required);
  value: Value;
}

/* -------------------------------------------------------------------- */
/* Controls
 *
 * What Blender's interface shows, by meaning rather than by look: an interface draws each kind
 * with its own native control. What every control has, such as its label and whether it can be
 * edited, is on the node, see `Node`. */

/// How a container lays out its children.
enum Layout : ubyte {
  /// One under another.
  Column,
  /// Side by side, such as the X, Y and Z of a location.
  Row,
  /// Side by side and joined, as one control, such as a row of toggles.
  Joined,
}

/// A group of controls: the whole of a view, a panel's body, or a row.
table Group {
  layout: Layout;
}

/// A panel, which can be opened and closed. Its controls are its children, some drawn in its
/// header, see `Role`.
table Panel {
  expanded: bool = true;
  /// It cannot be closed.
  fixed: bool;
  /// The active one of a stack of panels, such as the active modifier.
  active: bool;
  /// Its place in a stack of panels that can be put in another order, such as modifiers, which
  /// `Move` with the place as `value` does; -1 when not in one.
  position: int = -1;
  /// It can be opened: not when there is nothing in it, as a physics that is off.
  openable: bool = true;
}

/// A switch.
table Toggle {
  value: bool;
  /// Drawn as a button that stays pressed, rather than as a switch.
  button: bool;
}

/// What a number measures, for its units and how it is edited.
enum NumberKind : ubyte {
  Plain,
  /// Between 0 and 1.
  Factor,
  Percentage,
  /// In radians, shown in degrees.
  Angle,
  Distance,
  Area,
  Volume,
  Mass,
  Time,
  /// A frame number.
  Frame,
  Pixels,
  Temperature,
  Wavelength,
}

/// How a slider's range maps to its length.
enum Scale : ubyte {
  Linear,
  Logarithmic,
  Cubic,
}

/// A number.
table Number {
  value: double;
  /// A whole number.
  integer: bool;
  kind: NumberKind;
  /// The hard range, which values are clamped to.
  min: double = -inf;
  max: double = inf;
  /// The soft range, which dragging and sliders cover.
  soft_min: double = -inf;
  soft_max: double = inf;
  /// How much a step of dragging changes it, and how many decimals show.
  step: double;
  precision: ubyte = 3;
  /// Drawn as a slider over the soft range.
  slider: bool;
  scale: Scale;
  /// Shown after the value, such as "px", or the scene's unit, such as "m" (ROUND6 PANEL-9).
  unit: string;
  /// What it is reset to.
  default_value: double;
  /// What the value is multiplied by to show it in `unit`, such as the scene's Unit Scale, or the
  /// meters in a foot for imperial lengths; the value itself stays in Blender's units.
  unit_factor: double = 1;
}

/// Text.
table TextField {
  value: string;
  multiline: bool;
  /// A file or folder path, which an interface may pick with its own browser.
  path: bool;
}

/// One choice of a `Choice`, or a heading between groups of them.
table Option {
  /// What the choice sets; none for a heading.
  value: string;
  label: string;
  icon: string;
  /// An image of it, such as a MatCap's, to show instead of the icon.
  preview: string;
  description: string;
  /// Options group under headings by this number, such as the Preferences' sections.
  group: int;
  /// Chosen without the interface showing it, as a section only Blender's own Preferences show.
  external: bool;
}

/// How a choice is drawn.
enum ChoiceStyle : ubyte {
  /// A menu.
  Menu,
  /// All its options at once, as a row of buttons.
  Expanded,
  /// As tabs.
  Tabs,
  /// A menu of things to do: choosing one does it, and none stays chosen.
  Actions,
}

/// A choice of options, such as an enum.
table Choice {
  /// The chosen option's value.
  value: string;
  options: [Option];
  style: ChoiceStyle;
  /// Several options can be chosen at once: `value` lists them, separated by commas.
  multiple: bool;
}

/// A color.
table Color {
  /// Red, green, blue and maybe alpha, in display space.
  value: [double];
  alpha: bool;
}

/// A data-block chosen for a property, such as an object's material. Commands: `Set` chooses
/// another by its `value`, `Add` makes a new one, or loads one from the files its texts name (a
/// font's regular, bold, italic and bold italic faces), `Remove` takes it away, `Rename` renames
/// it, and `Invoke` with `fake_user` or `single_user` toggles its fake user or makes it
/// single-user.
table Reference {
  /// The data-block's type, such as "Material".
  type: string;
  /// The chosen data-block's name, or none.
  name: string;
  /// Its stable identifier, to choose it by.
  value: string;
  users: int;
  linked: bool;
  fake_user: bool;
  /// What can be done with it: a new one, take it away, make it single-user, or keep it with a
  /// fake user.
  can_new: bool;
  can_unlink: bool;
  can_single_user: bool;
  can_fake_user: bool;
  /// The data-blocks to choose from, each described by its users. Long lists come as a view of
  /// their own instead.
  options: [Option];
  /// An image of the chosen one.
  preview: string;
  /// A font, which an interface may choose with its own font picker.
  font: bool;
  /// The file it was loaded from, such as a font's.
  file: string;
}

/// How a button is drawn.
enum ButtonStyle : ubyte {
  Normal,
  /// The main action of its panel or dialog.
  Prominent,
  /// It deletes or removes something.
  Destructive,
}

/// A button, which runs something when invoked.
table Button {
  style: ButtonStyle;
  /// The operator it runs, with these properties, for interfaces that show the operator's icon or
  /// shortcut.
  operator: string;
  params: [Param];
  /// The key that does the same in Blender's own interface, which an interface may send instead,
  /// such as X to constrain a move to the X axis while it runs.
  key: string;
  /// It shows as pressed, as one that turns something on, such as X-Ray, while it is on.
  pressed: bool;
  /// Blender shows only its icon, such as the X that removes an item: its label is for those who
  /// can't see it.
  icon_only: bool;
}

/// A button that opens a menu, a view of its own named here.
table MenuButton {
  /// The menu's view and its parameters, for the interface to subscribe to when it opens.
  view: string;
  params: [Param];
}

/// Text that cannot be edited, such as a property shown for information.
/// How a line of text reads, as Blender's icon or alert marks it (ROUND6 PANEL-2).
enum LabelStyle : ubyte {
  Plain,
  /// Blender's info icon: a note.
  Info,
  /// Blender's warning triangle (`ERROR`).
  Warning,
  /// Blender's red alert, or its cancel icon: something does not work, such as a modifier's error.
  Error,
}

table Label {
  value: string;
  style: LabelStyle;
}

/// A line between controls.
table Separator {
}

/// An asset of a library, such as a material to drag into the scene, as a row of a list: its name
/// is the node's label, and what it is about its description.
table Asset {
  /// What it is, such as "Material" or "Modifier".
  type: string;
  library: string;
  /// Its catalog's path, such as "Materials/Metal".
  catalog: string;
  author: string;
  tags: [string];
  /// An image of it.
  preview: string;
}

/// An item of a canvas, such as a node of a node tree or a curve of an animation, by its values:
/// `params`, each a value by its name, as the canvas's view describes them. Lists of items in it,
/// such as a node's sockets, are its children.
table Record {
  params: [Param];
}

/// A color ramp, such as a node's: colors at stops along it, blended between. Commands: `Set` with
/// a float moves the active stop there, `Activate` with an int makes that stop the active one,
/// `Add` with a float adds a stop there and `Remove` removes the active one. The active stop's
/// position and color are controls of their own.
table Ramp {
  /// Its colors from start to end, evenly spaced: red, green, blue and alpha each, in display
  /// space.
  colors: [double];
  /// Its stops in order, five numbers each: the position, from 0 to 1, and the color.
  stops: [double];
  active: int;
}

/// A curve edited by its points (ROUND6 PANEL-7, B7): a curve mapping, such as a brush's falloff
/// or colour management's curves, or a profile, such as a Bevel's custom profile. Commands:
/// `Activate` with an int makes that point the active one; `Set` with floats x, y moves it there
/// (with a phase, as one step to undo); `Add` with floats x, y adds a point there; `Remove`
/// removes the active one; `Set` with a text: `handle:<type>` (the active point's, Blender's
/// `HD_*`), `channel:<n>`, `reset`, `reverse` (a profile), `extrapolate:<0|1>` (a mapping),
/// `clipping:<0|1>`, `clip:<min x>,<min y>,<max x>,<max y>`.
table Curve {
  /// Each point's x and y, in order.
  points: [double];
  /// Each point's handle type, as Blender's `HD_*`: 0 free, 1 automatic, 2 vector, 3 aligned,
  /// 4 auto-clamped.
  handles: [ubyte];
  /// The active point, or -1.
  active: int = -1;
  /// The curve through them, x and y in order, as Blender evaluates it.
  samples: [double];
  /// The rectangle the points are kept in: minimum x, minimum y, maximum x, maximum y.
  clip: [double];
  /// Whether the points are kept in that rectangle.
  clipping: bool;
  /// A mapping's curves, as Blender's tabs over it name them (X, Y, Z; C, R, G, B), and the one
  /// shown; none for one curve.
  channels: [string];
  channel: int;
  /// A profile, whose handles can be free or aligned, rather than a mapping.
  profile: bool;
  /// A mapping's ends go on straight rather than level.
  extrapolate: bool;
}

/// A value an interface uses as it sees fit, rather than a control: such as where Blender draws
/// the navigation gizmo, for an interface to keep clear of it.
table Data {
  value: Value;
}

/// A list of items, such as material slots or shape keys: its rows are its children, each with
/// controls of its own.
table List {
  /// The active row's key.
  active: string;
  can_add: bool;
  can_remove: bool;
  can_reorder: bool;
  /// Its rows nest, as a tree.
  tree: bool;
  /// A menu of more it can do, as a `MenuButton` names it.
  menu: string;
  /// Still filling in, such as while previews are drawn.
  loading: bool;
}

/// A row of a list.
table Row {
  depth: int;
  selected: bool;
  /// Its name can be renamed in place.
  renamable: bool;
  /// An image to show instead of the icon.
  preview: string;
  /// The heading it is listed under, such as a brush's catalog.
  section: string;
}

/// A picture, such as a material's rendered preview.
table Picture {
  image: string;
}

/// A menu: its items are its children, controls like any other.
table Menu {
}

/// An operation's settings, its children: the last one's, to adjust it, or one's asked for before
/// it runs, as a dialog. Commands: `Invoke` with `dismiss`, `confirm` or `cancel`.
table Operator {
  /// The operator, such as `TRANSFORM_OT_translate`.
  idname: string;
  /// What a dialog's button to run it says.
  confirm: string;
  /// What a dialog says above its settings.
  message: string;
  /// Why the last change to its settings failed.
  error: string;
  /// How often it was asked to show, as Blender's Adjust Last Operation does: an interface shows
  /// it when this grows.
  shown: uint;
}

/// What a node is.
union Content {
  Group,
  Panel,
  Toggle,
  Number,
  TextField,
  Choice,
  Color,
  Reference,
  Button,
  MenuButton,
  Label,
  Separator,
  List,
  Row,
  Picture,
  Menu,
  Operator,
  Data,
  Asset,
  Record,
  Ramp,
  Curve,
}

/* -------------------------------------------------------------------- */
/* Nodes */

/// What a control is to the one it belongs to, for interfaces that show it with it.
enum Role : ubyte {
  None,
  /// Locks the control it is a child of.
  Lock,
  /// The mode of the row it is a child of, such as a rotation's.
  Mode,
  /// The shape of the preview it is a child of.
  Shape,
  /// The name of the panel it is in the header of, such as a modifier's.
  Name,
  /// Where the panel it is in the header of applies, such as a modifier's Edit Mode and Render.
  Visibility,
  /// Duplicates the active row of the list it is a child of.
  Duplicate,
  /// Drawn in the header of the panel it is a child of, such as a modifier's Remove.
  Header,
  /// Where a data-block it follows is linked, such as a material slot's Object or Data: drawn at
  /// the end of that data-block's row, as Blender draws it, by an interface that knows it.
  Link,
  /// Says, as its label, what the panel or tab it is a child of could not show, and goes to the
  /// Desktop Interface, where Blender draws all of it (ROUND6 PANEL-1, decision R6-9).
  Elsewhere,
}

/// How a property is animated, as Blender colors its control.
enum Animation : ubyte {
  None,
  /// Keyed on this frame.
  Keyed,
  Animated,
  /// Changed from its animated value.
  Changed,
  Driven,
}

/// A node of a view: a control, a container of controls, or an item of a canvas. Its children
/// are sent apart from it, see `Children`, so a change to one does not resend the others.
table Node {
  /// Stable within the view for as long as the node shows the same thing, such as a property's
  /// data path, so an interface keeps its state, and commands find it.
  key: string (required);
  content: Content;

  label: string;
  /// Blender's icon name.
  icon: string;
  /// What it does, as Blender's tooltip says.
  description: string;
  /// It can be changed or used.
  enabled: bool = true;
  /// Several selected items differ in this value.
  mixed: bool;
  animation: Animation;
  /// Its keyframes can be inserted and removed, see `Op`.
  animatable: bool;
  /// The Blender property it edits, as a data path, for interfaces that show or copy it.
  property: string;
  role: Role;
  /// A shorter label, for where space is tight, such as the X of a mirror's axes.
  short_label: string;
  /// An icon to show before its label.
  leading_icon: string;
}

/* -------------------------------------------------------------------- */
/* Updates: Blender to the interface */

/// A node as sent: a buffer of its own, which an interface can keep without the rest of the
/// update it came in.
table NodeBuffer {
  node: [ubyte] (required, nested_flatbuffer: "Node");
}

/// The children of a node, in order.
table Children {
  parent: string (required);
  keys: [string];
}

/// What changed in a view since its last update.
table Update {
  subscription: uint;
  /// One more than the last update of this subscription, so a gap shows something went missing.
  version: uint;
  /// Start again from nothing: the view is sent whole.
  reset: bool;
  /// The view's top node, sent with `reset`.
  top: string;
  /// New nodes, and nodes that changed in any way, sent whole.
  nodes: [NodeBuffer];
  /// Nodes whose children are new or changed, or now have none.
  children: [Children];
  /// Keys of nodes gone from the view, with their children.
  removed: [string];
}

/// The outcome of a command.
table Ack {
  command: uint;
  /// Why it failed, or nothing when it worked.
  error: string;
}

/// What Blender sends at once, see `WM_native_ui_take_updates`.
table Updates {
  updates: [Update];
  acks: [Ack];
}

/* -------------------------------------------------------------------- */
/* Requests: the interface to Blender */

/// Show a view, see `WM_native_ui_subscribe`.
table Subscribe {
  /// Such as `properties`, `tool_settings` or `menu`.
  view: string (required);
  params: [Param];
}

/// What a command does to its node.
enum Op : ubyte {
  /// Give it `value`.
  Set,
  /// Run it: a button, or a menu's item.
  Invoke,
  /// Open or close a panel, or a row of a tree.
  Open,
  Close,
  /// Make a row of a list active.
  Activate,
  /// Give a row a new name, `value`.
  Rename,
  /// Move a row of a list to before the row named by `value`, or to the end without one.
  Move,
  Add,
  Remove,
  /// Keyframes of its property: insert, delete or clear them, all of an array's with `value` set.
  KeyframeInsert,
  KeyframeDelete,
  KeyframesClear,
}

/// Where a command is in a continuous change, such as a drag: Blender makes one undo step of it.
enum Phase : ubyte {
  /// A change on its own.
  Once,
  Begin,
  Update,
  End,
  /// The change is taken back, as a drag let go where it started.
  Cancel,
}

/// Something done to a node of a view.
table Command {
  /// Answered with an `Ack` of the same number; 0 for none.
  id: uint;
  subscription: uint;
  /// The node's key.
  target: string (required);
  op: Op;
  value: Value;
  phase: Phase;
  /// What it is done with, such as the properties of an operator it runs.
  params: [Param];
  /// The version of the view's update the interface showed when it was sent (`Update::version`),
  /// 0 for none. A command that changes data is refused when its node changed or went since then,
  /// as after another command ran first (ROUND6 BUSY-2): it was meant for what was shown.
  version: uint;
}

/// Commands sent at once, see `WM_native_ui_send`.
table Commands {
  commands: [Command];
}
