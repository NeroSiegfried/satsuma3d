// The contract between Blender and a platform's own interface, such as the iPad's: every snapshot
// Blender sends and every command it takes, see `WM_native_ui.h`. In the FlatBuffers schema
// language, so `flatc` can give a binary encoding from the same file; until then the bridge sends
// JSON as FlatBuffers writes it. `native_ui_schema.py` generates each interface's types from here
// and validates Blender's snapshots against it.
//
// A `[ubyte] (flexbuffer)` field takes any JSON: a part of a snapshot still to be described.
// `nullable_elements`: a list that holds nulls between its items, such as separators.

namespace Blender.NativeUI;

attribute "nullable_elements";

/// What the interface around the viewport shows that is not in the `toolbar` view yet. Sent with
/// every change, see `WM_native_ui_toolbar_take_json`.
table Toolbar {
  /// Blender's context mode, such as `objectmode` or `edit_mesh`.
  mode: string (required);
  /// A render in progress, or its result.
  render: [ubyte] (flexbuffer);
  preferences: [ubyte] (flexbuffer);
}

root_type Toolbar;
